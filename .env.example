# ===========================================================================
# ESEMPIO. Questo file NON contiene chiavi e non ne conterrà mai.
# ===========================================================================
# Copialo in `.env` (`cp .env.example .env`) e riempi i valori SOLO nella tua
# copia. `.env` è già nel .gitignore: non finisce nel repository, non finisce
# in un commit, non finisce su GitHub.
#
# Sul server che aggiorna il sito da solo (GitHub Actions) questi valori NON
# stanno in un file: stanno nei Secrets del repository.
#   GitHub → il repository → Settings → Secrets and variables → Actions.
# La guida passo per passo è in AGGIORNAMENTO.md.
#
# ⚠️ Se una di queste chiavi finisce per sbaglio in un commit, va considerata
# bruciata: si revoca su developers.facebook.com e se ne fa una nuova. Non
# basta cancellare il file, perché resta nella storia di git.
# ===========================================================================

# --- Instagram ------------------------------------------------------------
# L'id numerico dell'account Instagram Business della società
# (@amatori_hockey_pesaro_asd). NON è il nome utente: è un numero lungo.
# Come si trova: AGGIORNAMENTO.md, passo 5.
IG_USER_ID=

# Il token di accesso di Instagram. Comincia per "IG..." ed è lunghissimo.
IG_TOKEN=

# --- Facebook -------------------------------------------------------------
# L'id numerico della Pagina Facebook (facebook.com/amatorihockeypesaro).
FB_PAGE_ID=

# Il Page Access Token DI LUNGA DURATA della Pagina. Comincia per "EAA...".
# Quello che l'esploratore mostra all'inizio dura un'ora: non è questo.
FB_TOKEN=

# --- Facoltative: normalmente si lasciano vuote ----------------------------
# La versione dell'API di Meta. Se un giorno Meta ritira quella che usiamo,
# lo script lo dice e qui si mette la nuova (es. v24.0). Vuoto = v23.0.
META_API_VERSION=

# Quanti post chiedere a ogni giro. Vuoto = 25.
META_LIMITE=

# Da quale host si leggono i post di Instagram. Vuoto = graph.instagram.com,
# che è la strada descritta in AGGIORNAMENTO.md («Instagram API with
# Instagram Login», permesso instagram_business_basic).
# Se invece l'app è stata fatta con «Instagram API with Facebook Login»,
# qui va scritto: graph.facebook.com
IG_API_HOST=

# Dopo quante ore senza riuscire a leggere la FISR l'aggiornamento smette di
# considerarlo un intoppo e comincia a segnalare un guasto. Vuoto = 48.
FISR_ORE_TOLLERATE=
