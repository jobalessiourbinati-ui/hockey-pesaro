{"slug":"storia","title":{"rendered":"STORIA"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"107\" class=\"elementor elementor-107\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ba523ca e-flex e-con-boxed e-con e-parent\" data-id=\"ba523ca\" data-element_type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-aa31a3d elementor-widget elementor-widget-html\" data-id=\"aa31a3d\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\r\n<head>\r\n  <meta charset=\"UTF-8\" \/>\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" \/>\r\n  <title>Le Giovanili \u2014 Amatori Hockey Pesaro<\/title>\r\n  <meta name=\"description\" content=\"Il settore giovanile dell'Amatori Hockey Pesaro: Under 19, Under 17, Under 15, Under 13 e Under 11.\" \/>\r\n  <link rel=\"icon\" href=\"https:\/\/www.hockeypesaro.it\/wp-content\/uploads\/2024\/11\/hockey_pesaro_logo-01-1.png\" \/>\r\n  <link rel=\"stylesheet\" href=\"style.css\" \/>\r\n  <style>\r\n    \/* Sotto-navigazione categorie *\/\r\n    .cat-nav {\r\n      position: sticky;\r\n      top: 58px;\r\n      z-index: 100;\r\n      background: var(--surface);\r\n      border-bottom: 1px solid var(--line);\r\n    }\r\n    .cat-nav-inner {\r\n      max-width: var(--max-w);\r\n      margin: 0 auto;\r\n      padding: 0 24px;\r\n      display: flex;\r\n      gap: 4px;\r\n      overflow-x: auto;\r\n      scrollbar-width: none;\r\n    }\r\n    .cat-nav-inner::-webkit-scrollbar { display: none; }\r\n    .cat-nav-btn {\r\n      font-family: var(--font-head);\r\n      font-size: 13px; font-weight: 700;\r\n      letter-spacing: 1.5px; text-transform: uppercase;\r\n      color: var(--muted);\r\n      padding: 15px 18px;\r\n      border-bottom: 2px solid transparent;\r\n      white-space: nowrap;\r\n      transition: color 0.15s, border-color 0.15s;\r\n    }\r\n    .cat-nav-btn:hover { color: var(--white); }\r\n    .cat-nav-btn.active { color: var(--red); border-bottom-color: var(--red); }\r\n\r\n    \/* Intro *\/\r\n    .gv-intro { padding: 64px 0 8px; }\r\n    .gv-intro-text {\r\n      max-width: 720px;\r\n      font-size: 16px; color: rgba(245,245,245,0.7);\r\n      line-height: 1.85;\r\n    }\r\n    .gv-intro-stats {\r\n      display: grid;\r\n      grid-template-columns: repeat(4, 1fr);\r\n      gap: 12px;\r\n      margin-top: 40px;\r\n    }\r\n    .gv-stat {\r\n      background: var(--surface);\r\n      border: 1px solid var(--line);\r\n      border-radius: var(--radius);\r\n      padding: 24px 18px;\r\n      text-align: center;\r\n    }\r\n    .gv-stat-n {\r\n      font-family: var(--font-head);\r\n      font-size: 44px; font-weight: 900; line-height: 1;\r\n      color: var(--red);\r\n    }\r\n    .gv-stat-l {\r\n      font-size: 11px; color: var(--muted);\r\n      letter-spacing: 1.5px; text-transform: uppercase; margin-top: 5px;\r\n    }\r\n\r\n    \/* Sezione categoria *\/\r\n    .cat-section {\r\n      padding: 64px 0;\r\n      border-top: 1px solid var(--line);\r\n      scroll-margin-top: 110px;\r\n    }\r\n    .cat-section:nth-child(even) {\r\n      background: var(--surface);\r\n    }\r\n\r\n    .cat-head {\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 22px;\r\n      margin-bottom: 32px;\r\n    }\r\n    .cat-bignum {\r\n      font-family: var(--font-head);\r\n      font-size: clamp(64px, 11vw, 110px);\r\n      font-weight: 900; line-height: 0.82;\r\n      color: var(--red);\r\n      flex-shrink: 0;\r\n    }\r\n    .cat-head-text {}\r\n    .cat-eyebrow {\r\n      font-family: var(--font-head);\r\n      font-size: 10px; font-weight: 700;\r\n      letter-spacing: 3px; text-transform: uppercase;\r\n      color: var(--red); margin-bottom: 6px;\r\n    }\r\n    .cat-name {\r\n      font-family: var(--font-head);\r\n      font-size: clamp(32px, 5vw, 46px);\r\n      font-weight: 900; text-transform: uppercase;\r\n      line-height: 0.95; letter-spacing: -0.5px;\r\n      color: var(--white); margin-bottom: 10px;\r\n    }\r\n    .cat-desc {\r\n      font-size: 14px; color: var(--muted);\r\n      line-height: 1.7; max-width: 560px;\r\n    }\r\n\r\n    .cat-gallery-label {\r\n      font-family: var(--font-head);\r\n      font-size: 10px; font-weight: 700;\r\n      letter-spacing: 3px; text-transform: uppercase;\r\n      color: var(--muted); margin-bottom: 16px;\r\n    }\r\n\r\n    \/* override gallery item bg per leggibilit\u00e0 su sfondi alternati *\/\r\n    .cat-section:nth-child(even) .gallery-item { background: var(--black); }\r\n\r\n    @media (max-width: 580px) {\r\n      .gv-intro-stats { grid-template-columns: repeat(2, 1fr); }\r\n      .cat-head { gap: 16px; }\r\n    }\r\n  <\/style>\r\n<\/head>\r\n<body>\r\n<script src=\"shared.js\"><\/script>\r\n<script>renderHeader('giovanili.html');<\/script>\r\n\r\n<main>\r\n  <div class=\"page-hero\">\r\n    <div class=\"container\">\r\n      <div class=\"page-hero-label\">Il vivaio rossonero<\/div>\r\n      <h1 class=\"page-hero-title\">Le<br><em>Giovanili<\/em><\/h1>\r\n      <p class=\"page-hero-sub\">Dalla Under 11 alla Under 19: il settore giovanile \u00e8 il cuore pulsante dell'Amatori Hockey Pesaro, dove cresce il talento di domani.<\/p>\r\n    <\/div>\r\n  <\/div>\r\n\r\n  <!-- SOTTO-NAV CATEGORIE -->\r\n  <nav class=\"cat-nav\" aria-label=\"Categorie giovanili\">\r\n    <div class=\"cat-nav-inner\">\r\n      <a href=\"#u19\" class=\"cat-nav-btn\">Under 19<\/a>\r\n      <a href=\"#u17\" class=\"cat-nav-btn\">Under 17<\/a>\r\n      <a href=\"#u15\" class=\"cat-nav-btn\">Under 15<\/a>\r\n      <a href=\"#u13\" class=\"cat-nav-btn\">Under 13<\/a>\r\n      <a href=\"#u11\" class=\"cat-nav-btn\">Under 11<\/a>\r\n    <\/div>\r\n  <\/nav>\r\n\r\n  <!-- INTRO -->\r\n  <section class=\"gv-intro\">\r\n    <div class=\"container\">\r\n      <div class=\"section-eyebrow\">Il nostro impegno<\/div>\r\n      <h2 class=\"section-title\" style=\"margin-bottom:22px;\">Cinque squadre,<br>una sola famiglia<\/h2>\r\n      <p class=\"gv-intro-text\">Il club si dedica con passione alla crescita dei giovani atleti, coltivando talenti locali e promuovendo l'hockey su pista sul territorio. Ogni categoria rappresenta una tappa del percorso che, dai primi passi sulla pista, porta i ragazzi fino alla prima squadra. Allenamento, disciplina e divertimento sono i valori che guidano tutto il nostro settore giovanile.<\/p>\r\n      <div class=\"gv-intro-stats\">\r\n        <div class=\"gv-stat\"><div class=\"gv-stat-n\">5<\/div><div class=\"gv-stat-l\">Categorie<\/div><\/div>\r\n        <div class=\"gv-stat\"><div class=\"gv-stat-n\">U11<\/div><div class=\"gv-stat-l\">Si parte da<\/div><\/div>\r\n        <div class=\"gv-stat\"><div class=\"gv-stat-n\">U19<\/div><div class=\"gv-stat-l\">Fino alla<\/div><\/div>\r\n        <div class=\"gv-stat\"><div class=\"gv-stat-n\">\u2605<\/div><div class=\"gv-stat-l\">U17 campioni prov.<\/div><\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- UNDER 19 -->\r\n  <section class=\"cat-section\" id=\"u19\">\r\n    <div class=\"container\">\r\n      <div class=\"cat-head\">\r\n        <div class=\"cat-bignum\">19<\/div>\r\n        <div class=\"cat-head-text\">\r\n          <div class=\"cat-eyebrow\">Settore giovanile<\/div>\r\n          <h2 class=\"cat-name\">Under 19<\/h2>\r\n          <p class=\"cat-desc\">I ragazzi tra i 17 e i 19 anni, a un passo dalla prima squadra. L'ultima tappa del percorso giovanile, dove tecnica ed esperienza si fondono.<\/p>\r\n        <\/div>\r\n      <\/div>\r\n      <div class=\"cat-gallery-label\">\u2014 Galleria foto<\/div>\r\n      <div class=\"gallery-grid\">\r\n        <!-- Sostituire con <img decoding=\"async\" src=\"foto.jpg\" alt=\"descrizione\"> -->\r\n        <div class=\"gallery-item\"><span>Foto 1<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 2<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 3<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 4<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 5<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 6<\/span><\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- UNDER 17 -->\r\n  <section class=\"cat-section\" id=\"u17\">\r\n    <div class=\"container\">\r\n      <div class=\"cat-head\">\r\n        <div class=\"cat-bignum\">17<\/div>\r\n        <div class=\"cat-head-text\">\r\n          <div class=\"cat-eyebrow\">Settore giovanile<\/div>\r\n          <h2 class=\"cat-name\">Under 17<\/h2>\r\n          <p class=\"cat-desc\">Campioni provinciali 2024. La categoria che esprime i talenti pi\u00f9 promettenti del vivaio, una generazione di promesse rossonere.<\/p>\r\n        <\/div>\r\n      <\/div>\r\n      <div class=\"cat-gallery-label\">\u2014 Galleria foto<\/div>\r\n      <div class=\"gallery-grid\">\r\n        <div class=\"gallery-item\"><span>Foto 1<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 2<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 3<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 4<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 5<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 6<\/span><\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- UNDER 15 -->\r\n  <section class=\"cat-section\" id=\"u15\">\r\n    <div class=\"container\">\r\n      <div class=\"cat-head\">\r\n        <div class=\"cat-bignum\">15<\/div>\r\n        <div class=\"cat-head-text\">\r\n          <div class=\"cat-eyebrow\">Settore giovanile<\/div>\r\n          <h2 class=\"cat-name\">Under 15<\/h2>\r\n          <p class=\"cat-desc\">Tecnica, disciplina e determinazione. La categoria che forgia i fondamentali del gioco e costruisce le basi dei futuri campioni.<\/p>\r\n        <\/div>\r\n      <\/div>\r\n      <div class=\"cat-gallery-label\">\u2014 Galleria foto<\/div>\r\n      <div class=\"gallery-grid\">\r\n        <div class=\"gallery-item\"><span>Foto 1<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 2<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 3<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 4<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 5<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 6<\/span><\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- UNDER 13 -->\r\n  <section class=\"cat-section\" id=\"u13\">\r\n    <div class=\"container\">\r\n      <div class=\"cat-head\">\r\n        <div class=\"cat-bignum\">13<\/div>\r\n        <div class=\"cat-head-text\">\r\n          <div class=\"cat-eyebrow\">Settore giovanile<\/div>\r\n          <h2 class=\"cat-name\">Under 13<\/h2>\r\n          <p class=\"cat-desc\">I giovani campioni che imparano il gioco con entusiasmo e voglia di crescere. La passione per l'hockey si fa sempre pi\u00f9 forte.<\/p>\r\n        <\/div>\r\n      <\/div>\r\n      <div class=\"cat-gallery-label\">\u2014 Galleria foto<\/div>\r\n      <div class=\"gallery-grid\">\r\n        <div class=\"gallery-item\"><span>Foto 1<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 2<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 3<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 4<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 5<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 6<\/span><\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- UNDER 11 -->\r\n  <section class=\"cat-section\" id=\"u11\">\r\n    <div class=\"container\">\r\n      <div class=\"cat-head\">\r\n        <div class=\"cat-bignum\">11<\/div>\r\n        <div class=\"cat-head-text\">\r\n          <div class=\"cat-eyebrow\">Settore giovanile<\/div>\r\n          <h2 class=\"cat-name\">Under 11<\/h2>\r\n          <p class=\"cat-desc\">Il primo approccio all'hockey su pista. Dove tutto comincia con il sorriso: divertimento e passione prima di ogni cosa.<\/p>\r\n        <\/div>\r\n      <\/div>\r\n      <div class=\"cat-gallery-label\">\u2014 Galleria foto<\/div>\r\n      <div class=\"gallery-grid\">\r\n        <div class=\"gallery-item\"><span>Foto 1<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 2<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 3<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 4<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 5<\/span><\/div>\r\n        <div class=\"gallery-item\"><span>Foto 6<\/span><\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- CTA -->\r\n  <section style=\"padding:72px 0; border-top:1px solid var(--line); text-align:center;\">\r\n    <div class=\"container\" style=\"max-width:600px;\">\r\n      <div class=\"section-eyebrow\" style=\"display:flex;justify-content:center;\">Unisciti a noi<\/div>\r\n      <h2 class=\"section-title\" style=\"margin-bottom:16px;\">Vuoi far parte del vivaio?<\/h2>\r\n      <p style=\"color:var(--muted);font-size:15px;line-height:1.8;margin-bottom:32px;\">Accogliamo nuovi giovani atleti in tutte le categorie. Vieni a provare l'hockey su pista con noi: contattaci per informazioni su allenamenti e iscrizioni.<\/p>\r\n      <a href=\"mailto:info@hockeypesaro.it\" class=\"btn-primary\">\r\n        Contattaci\r\n        <svg width=\"13\" height=\"13\" viewBox=\"0 0 13 13\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2 6.5h9M7 2.5l4 4-4 4\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/><\/svg>\r\n      <\/a>\r\n    <\/div>\r\n  <\/section>\r\n\r\n<\/main>\r\n\r\n<script>renderFooter();<\/script>\r\n\r\n<script>\r\n  \/* Evidenzia la categoria attiva nella sotto-nav durante lo scroll *\/\r\n  (function() {\r\n    const sections = document.querySelectorAll('.cat-section');\r\n    const navBtns = document.querySelectorAll('.cat-nav-btn');\r\n    const observer = new IntersectionObserver(function(entries) {\r\n      entries.forEach(function(entry) {\r\n        if (entry.isIntersecting) {\r\n          const id = entry.target.id;\r\n          navBtns.forEach(b => b.classList.toggle('active', b.getAttribute('href') === '#' + id));\r\n        }\r\n      });\r\n    }, { rootMargin: '-30% 0px -60% 0px' });\r\n    sections.forEach(s => observer.observe(s));\r\n  })();\r\n<\/script>\r\n<\/body>\r\n<\/html>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false}}